{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-package-meta.schema.json",
  "title": "Objekt-X strategic research package metadata",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "date",
    "kind",
    "strategic",
    "mathematical_status",
    "review_status",
    "integration_status",
    "depends_on",
    "does_not_claim",
    "canonical_proof"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}$"
    },
    "kind": {
      "type": "string"
    },
    "strategic": {
      "type": "boolean"
    },
    "mathematical_status": {
      "type": "string"
    },
    "review_status": {
      "type": "string"
    },
    "integration_status": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_only": {
      "type": "boolean"
    },
    "does_not_claim": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "canonical_proof": {
      "type": "object",
      "required": [
        "path",
        "commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "required": [
        "closes"
      ]
    },
    {
      "required": [
        "opens"
      ]
    },
    {
      "required": [
        "supersedes"
      ]
    },
    {
      "properties": {
        "local_only": {
          "const": true
        }
      },
      "required": [
        "local_only"
      ]
    }
  ],
  "additionalProperties": true
}
